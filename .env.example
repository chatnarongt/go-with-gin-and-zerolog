# Environment variables at root level (shared across all applications)

#- Application environment (development, staging, production)
APP_ENV=development
#- application port to listen on
APP_PORT=8080
#- log level (-1=trace, 0=debug, 1=info, 2=warn, 3=error, 4=fatal, 5=panic)
APP_LOG_LEVEL=-1
#- debug mode (true, false) pretty print logs and enable debug features
APP_DEBUG_MODE=true
#- enable CORS (true, false)
APP_CORS_ENABLED=true
#- CORS allowed origins (comma-separated list)
APP_CORS_ALLOWED_ORIGINS=*
#- CORS allowed methods (comma-separated list)
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
#- CORS allowed headers (comma-separated list)
APP_CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
#- enable swagger documentation (true, false)
APP_SWAGGER_ENABLED=false
#- swagger UI base path (absolute path)
APP_SWAGGER_BASE_PATH=/swagger
#- OpenAPI server URL override (leave empty to use spec default)
APP_SWAGGER_SERVER_URL=

#- Main Database driver (sqlite, postgres, pgx, sqlserver, mssql)
DB_MAIN_DRIVER=sqlite
#- Main Database connection string / DSN
DB_MAIN_DSN=file:./data/app.db
#- Enforce read-only mode for database connection (true, false)
DB_MAIN_READ_ONLY=false
#- Maximum number of open connections to the database (default to 0 if not set, 0 means unlimited)
DB_MAIN_MAX_OPEN_CONNS=0
#- Maximum number of idle connections to the database (default to 2 if not set, 0 means unlimited)
DB_MAIN_MAX_IDLE_CONNS=2
#- Maximum amount of time a database connection may be reused (Go duration, 5m, 1h, etc., 0 means unlimited)
DB_MAIN_MAX_LIFETIME=0
#- Maximum amount of time a database connection may remain idle (Go duration, 5m, 1h, etc., 0 means unlimited)
DB_MAIN_MAX_IDLE_TIME=0

#- Analytics Database driver (sqlite, postgres, pgx, sqlserver, mssql)
DB_ANALYTICS_DRIVER=sqlite
#- Analytics Database connection string / DSN
DB_ANALYTICS_DSN=file:./data/analytics.db
#- Enforce read-only mode for database connection (true, false)
DB_ANALYTICS_READ_ONLY=false
#- Maximum number of open connections to the database (default to 0 if not set, 0 means unlimited)
DB_ANALYTICS_MAX_OPEN_CONNS=0
#- Maximum number of idle connections to the database (default to 2 if not set, 0 means unlimited)
DB_ANALYTICS_MAX_IDLE_CONNS=2
#- Maximum amount of time an database connection may be reused (Go duration, 5m, 1h, etc., 0 means unlimited)
DB_ANALYTICS_MAX_LIFETIME=0
#- Maximum amount of time an database connection may remain idle (Go duration, 5m, 1h, etc., 0 means unlimited)
DB_ANALYTICS_MAX_IDLE_TIME=0
